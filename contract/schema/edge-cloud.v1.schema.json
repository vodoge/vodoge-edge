{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vodoge.cloud/edge-cloud/v1/edge-cloud.schema.json",
  "title": "VoDoge Edge-to-Cloud protocol v1",
  "description": "Logical shape of one binary WebSocket MessagePack frame. The JSON form is the canonical schema representation; the wire form uses the same map keys and values encoded as MessagePack.",
  "$ref": "#/$defs/Envelope",
  "x-vodoge-contract": {
    "name": "vodoge-edge-cloud",
    "version": 1,
    "wire": {
      "transport": "wss",
      "port": 443,
      "websocket_subprotocol": "vodoge.edge.v1",
      "frame_encoding": "messagepack",
      "binary_frames_only": true,
      "permessage_deflate": false,
      "tls": {
        "minimum_version": "TLSv1.3",
        "maximum_version": "TLSv1.3",
        "allow_tls_1_2_or_lower_fallback": false,
        "client_authentication": "mTLS required",
        "server_certificate_validation": "required",
        "allowed_cipher_suites": [
          "TLS_AES_256_GCM_SHA384",
          "TLS_CHACHA20_POLY1305_SHA256",
          "TLS_AES_128_GCM_SHA256"
        ],
        "allow_early_data": false,
        "early_data_policy": "No application envelope, especially a command or other non-idempotent action, may use TLS 0-RTT."
      },
      "max_frame_bytes": 1048576,
      "max_control_payload_bytes": 16384,
      "heartbeat_interval_ms": 30000,
      "idle_timeout_ms": 90000,
      "resume_first_frame_deadline_ms": 10000
    },
    "compatibility": {
      "unknown_fields": "reject",
      "unknown_kinds": "reject",
      "breaking_change": "increment v and publish a new schema",
      "sequence_encoding": "canonical decimal string representing an unsigned 64-bit integer"
    }
  },
  "x-vodoge-message-catalog": {
    "Resume": { "direction": "edge_to_cloud", "sequenced": false, "max_payload_bytes": 16384 },
    "ResumeAck": { "direction": "cloud_to_edge", "sequenced": false, "max_payload_bytes": 16384 },
    "UplinkAck": { "direction": "cloud_to_edge", "sequenced": false, "max_payload_bytes": 16384 },
    "UplinkGap": { "direction": "edge_to_cloud", "sequenced": false, "max_payload_bytes": 16384 },
    "UplinkGapAck": { "direction": "cloud_to_edge", "sequenced": false, "max_payload_bytes": 16384 },
    "Ping": { "direction": "edge_to_cloud", "sequenced": false, "max_payload_bytes": 1024 },
    "Pong": { "direction": "cloud_to_edge", "sequenced": false, "max_payload_bytes": 1024 },
    "CommandDeliver": { "direction": "cloud_to_edge", "sequenced": false, "max_payload_bytes": 131072 },
    "CommandReceipt": { "direction": "edge_to_cloud", "sequenced": false, "max_payload_bytes": 4096 },
    "SmsReceived": { "direction": "edge_to_cloud", "sequenced": true, "max_payload_bytes": 32768 },
    "SmsStatusReport": { "direction": "edge_to_cloud", "sequenced": true, "max_payload_bytes": 4096 },
    "DeviceState": { "direction": "edge_to_cloud", "sequenced": true, "max_payload_bytes": 131072 },
    "CommandResult": { "direction": "edge_to_cloud", "sequenced": true, "max_payload_bytes": 32768 },
    "EsimInventory": { "direction": "edge_to_cloud", "sequenced": true, "max_payload_bytes": 131072 },
    "Alert": { "direction": "edge_to_cloud", "sequenced": true, "max_payload_bytes": 32768 },
    "ProxyTraffic": { "direction": "edge_to_cloud", "sequenced": true, "max_payload_bytes": 65536 },
    "ProtocolError": { "direction": "cloud_to_edge", "sequenced": false, "max_payload_bytes": 4096 }
  },
  "$defs": {
    "Envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "kind", "id", "ts", "device_id", "payload"],
      "properties": {
        "v": { "const": 1 },
        "kind": { "$ref": "#/$defs/MessageKind" },
        "id": { "$ref": "#/$defs/Uuid" },
        "ts": { "$ref": "#/$defs/EpochMillis" },
        "device_id": { "$ref": "#/$defs/Uuid" },
        "seq": { "$ref": "#/$defs/SequenceNumber" },
        "trace_id": { "$ref": "#/$defs/Uuid" },
        "payload": {}
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "Resume" } }, "required": ["kind"] },
          "then": {
            "not": { "required": ["seq"] },
            "properties": { "payload": { "$ref": "#/$defs/ResumePayload" } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "ResumeAck" } }, "required": ["kind"] },
          "then": {
            "not": { "required": ["seq"] },
            "properties": { "payload": { "$ref": "#/$defs/ResumeAckPayload" } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "UplinkAck" } }, "required": ["kind"] },
          "then": {
            "not": { "required": ["seq"] },
            "properties": { "payload": { "$ref": "#/$defs/UplinkAckPayload" } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "UplinkGap" } }, "required": ["kind"] },
          "then": {
            "not": { "required": ["seq"] },
            "properties": { "payload": { "$ref": "#/$defs/UplinkGapPayload" } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "UplinkGapAck" } }, "required": ["kind"] },
          "then": {
            "not": { "required": ["seq"] },
            "properties": { "payload": { "$ref": "#/$defs/UplinkGapAckPayload" } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "Ping" } }, "required": ["kind"] },
          "then": {
            "not": { "required": ["seq"] },
            "properties": { "payload": { "$ref": "#/$defs/PingPayload" } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "Pong" } }, "required": ["kind"] },
          "then": {
            "not": { "required": ["seq"] },
            "properties": { "payload": { "$ref": "#/$defs/PongPayload" } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "CommandDeliver" } }, "required": ["kind"] },
          "then": {
            "not": { "required": ["seq"] },
            "properties": { "payload": { "$ref": "#/$defs/CommandDeliverPayload" } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "CommandReceipt" } }, "required": ["kind"] },
          "then": {
            "not": { "required": ["seq"] },
            "properties": { "payload": { "$ref": "#/$defs/CommandReceiptPayload" } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "SmsReceived" } }, "required": ["kind"] },
          "then": {
            "required": ["seq"],
            "properties": { "payload": { "$ref": "#/$defs/SmsReceivedPayload" } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "SmsStatusReport" } }, "required": ["kind"] },
          "then": {
            "required": ["seq"],
            "properties": { "payload": { "$ref": "#/$defs/SmsStatusReportPayload" } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "DeviceState" } }, "required": ["kind"] },
          "then": {
            "required": ["seq"],
            "properties": { "payload": { "$ref": "#/$defs/DeviceStatePayload" } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "CommandResult" } }, "required": ["kind"] },
          "then": {
            "required": ["seq"],
            "properties": { "payload": { "$ref": "#/$defs/CommandResultPayload" } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "EsimInventory" } }, "required": ["kind"] },
          "then": {
            "required": ["seq"],
            "properties": { "payload": { "$ref": "#/$defs/EsimInventoryPayload" } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "Alert" } }, "required": ["kind"] },
          "then": {
            "required": ["seq"],
            "properties": { "payload": { "$ref": "#/$defs/AlertPayload" } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "ProtocolError" } }, "required": ["kind"] },
          "then": {
            "not": { "required": ["seq"] },
            "properties": { "payload": { "$ref": "#/$defs/ProtocolErrorPayload" } }
          }
        }
      ]
    },
    "MessageKind": {
      "type": "string",
      "enum": [
        "Resume",
        "ResumeAck",
        "UplinkAck",
        "UplinkGap",
        "UplinkGapAck",
        "Ping",
        "Pong",
        "CommandDeliver",
        "CommandReceipt",
        "SmsReceived",
        "SmsStatusReport",
        "DeviceState",
        "CommandResult",
        "EsimInventory",
        "Alert",
        "ProxyTraffic",
        "ProtocolError"
      ]
    },
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "EpochMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 253402300799999,
      "description": "Unix epoch milliseconds. It is an observed time, not a trusted authorization clock."
    },
    "SequenceNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[1-9][0-9]{0,19}$",
      "x-vodoge-wire-type": "u64-decimal",
      "x-vodoge-invariant": "numeric value is in [1, 18446744073709551615] and has no leading zero"
    },
    "SequenceCursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "x-vodoge-wire-type": "u64-decimal",
      "x-vodoge-invariant": "numeric value is in [0, 18446744073709551615] and has no leading zero"
    },
    "SequenceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "through"],
      "properties": {
        "from": { "$ref": "#/$defs/SequenceNumber" },
        "through": { "$ref": "#/$defs/SequenceNumber" }
      },
      "x-vodoge-invariant": "numeric from is less than or equal to numeric through"
    },
    "Iccid": {
      "type": "string",
      "pattern": "^[0-9]{19,20}$"
    },
    "Imsi": {
      "type": "string",
      "pattern": "^[0-9]{14,15}$"
    },
    "Plmn": {
      "type": "string",
      "description": "Network as MCC-MNC, e.g. 460-01. Operator brands are neither unique nor stable; the numeric pair is.",
      "pattern": "^[0-9]{3}-[0-9]{2,3}$"
    },
    "Imei": {
      "type": "string",
      "pattern": "^[0-9]{14,16}$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "HttpsUrl": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^https://"
    },
    "NullableString": {
      "type": ["string", "null"],
      "maxLength": 1024
    },
    "ContextValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 4096 },
        {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/ContextValue" }
        },
        {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": { "$ref": "#/$defs/ContextValue" }
        }
      ]
    },
    "ResumePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection_id",
        "last_assigned_seq",
        "lowest_retained_seq",
        "last_acked_seq",
        "pending_gap_ids",
        "capability_matrix_version"
      ],
      "properties": {
        "connection_id": { "$ref": "#/$defs/Uuid" },
        "last_assigned_seq": { "$ref": "#/$defs/SequenceCursor" },
        "lowest_retained_seq": {
          "anyOf": [
            { "$ref": "#/$defs/SequenceNumber" },
            { "type": "null" }
          ]
        },
        "last_acked_seq": { "$ref": "#/$defs/SequenceCursor" },
        "pending_gap_ids": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Uuid" }
        },
        "capability_matrix_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "edge_version": { "type": "string", "maxLength": 128 },
        "queue_records": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "queue_bytes": { "type": "integer", "minimum": 0, "maximum": 10737418240 }
      },
      "x-vodoge-invariant": "last_acked_seq <= last_assigned_seq; lowest_retained_seq is null exactly when no unacknowledged records are retained"
    },
    "ResumeAckPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection_id",
        "committed_through",
        "missing_ranges",
        "more_missing",
        "max_in_flight",
        "server_time"
      ],
      "properties": {
        "connection_id": { "$ref": "#/$defs/Uuid" },
        "committed_through": { "$ref": "#/$defs/SequenceCursor" },
        "missing_ranges": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/SequenceRange" }
        },
        "more_missing": { "type": "boolean" },
        "max_in_flight": { "type": "integer", "minimum": 1, "maximum": 2048 },
        "server_time": { "$ref": "#/$defs/EpochMillis" }
      }
    },
    "UplinkAckPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connection_id", "committed_through", "missing_ranges", "more_missing", "max_in_flight"],
      "properties": {
        "connection_id": { "$ref": "#/$defs/Uuid" },
        "committed_through": { "$ref": "#/$defs/SequenceCursor" },
        "missing_ranges": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/SequenceRange" }
        },
        "more_missing": { "type": "boolean" },
        "max_in_flight": { "type": "integer", "minimum": 1, "maximum": 2048 }
      }
    },
    "UplinkGapPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gap_id", "ranges", "reason", "dropped_records", "occurred_at", "drop_policy"],
      "properties": {
        "gap_id": { "$ref": "#/$defs/Uuid" },
        "ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/SequenceRange" }
        },
        "reason": {
          "type": "string",
          "enum": ["queue_capacity", "storage_corruption", "operator_purge"]
        },
        "dropped_records": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "occurred_at": { "$ref": "#/$defs/EpochMillis" },
        "drop_policy": { "const": "oldest_non_verification_only" },
        "detail": { "$ref": "#/$defs/NullableString" }
      },
      "x-vodoge-invariant": "ranges are non-overlapping, each covers only records that are no longer retained, and dropped_records equals their total cardinality"
    },
    "UplinkGapAckPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gap_id", "accepted", "committed_through"],
      "properties": {
        "gap_id": { "$ref": "#/$defs/Uuid" },
        "accepted": { "type": "boolean" },
        "committed_through": { "$ref": "#/$defs/SequenceCursor" },
        "reason_code": { "$ref": "#/$defs/NullableString" }
      }
    },
    "PingPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connection_id", "sent_at"],
      "properties": {
        "connection_id": { "$ref": "#/$defs/Uuid" },
        "sent_at": { "$ref": "#/$defs/EpochMillis" }
      }
    },
    "PongPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connection_id", "ping_id", "server_time"],
      "properties": {
        "connection_id": { "$ref": "#/$defs/Uuid" },
        "ping_id": { "$ref": "#/$defs/Uuid" },
        "server_time": { "$ref": "#/$defs/EpochMillis" }
      }
    },
    "CommandDeliverPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cmd_id", "issued_at", "expires_at", "command"],
      "properties": {
        "cmd_id": { "$ref": "#/$defs/Uuid" },
        "issued_at": { "$ref": "#/$defs/EpochMillis" },
        "expires_at": { "$ref": "#/$defs/EpochMillis" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "command": { "$ref": "#/$defs/Command" }
      },
      "x-vodoge-invariant": "expires_at is greater than issued_at; the envelope id is the physical delivery_id and cmd_id is the logical command id"
    },
    "CommandReceiptPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cmd_id", "delivery_id", "status", "received_at"],
      "properties": {
        "cmd_id": { "$ref": "#/$defs/Uuid" },
        "delivery_id": { "$ref": "#/$defs/Uuid" },
        "status": { "type": "string", "enum": ["accepted", "duplicate", "retry_later"] },
        "received_at": { "$ref": "#/$defs/EpochMillis" },
        "retry_after_ms": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "reason_code": { "$ref": "#/$defs/NullableString" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "retry_later" } }, "required": ["status"] },
          "then": { "required": ["retry_after_ms"] }
        }
      ]
    },
    "SmsReceivedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modem_imei", "peer", "body", "received_at", "iccid", "bearer", "encoding"],
      "properties": {
        "modem_imei": { "$ref": "#/$defs/Imei" },
        "peer": { "type": "string", "minLength": 1, "maxLength": 64 },
        "body": { "type": "string", "maxLength": 16384 },
        "received_at": { "$ref": "#/$defs/EpochMillis" },
        "iccid": { "$ref": "#/$defs/Iccid" },
        "bearer": { "type": "string", "enum": ["cs", "ims", "nas", "unknown"] },
        "encoding": { "type": "string", "enum": ["gsm7", "ucs2", "8bit", "unknown"] },
        "modem_storage_index": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "SmsStatusReportPayload": {
      "type": "object",
      "additionalProperties": false,
      "description": "An SMS-STATUS-REPORT the network sent about a message this device submitted. Not a command receipt: that says the modem took the message, this says the network handed it over.",
      "required": ["modem_imei", "peer", "reference", "status", "reported_at"],
      "properties": {
        "modem_imei": { "$ref": "#/$defs/Imei" },
        "peer": { "type": "string", "minLength": 1, "maxLength": 64 },
        "reference": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "TP-MR of the original submission. Eight bits on the wire; carried wider because the modem reports the value it used and firmware is not obliged to keep it in range."
        },
        "status": {
          "type": "string",
          "enum": ["delivered", "pending", "failed", "unknown"],
          "description": "TP-ST reduced to an outcome. `pending` means the service centre is still trying, which is neither delivered nor failed."
        },
        "status_code": { "type": "integer", "minimum": 0, "maximum": 255 },
        "reported_at": { "$ref": "#/$defs/EpochMillis" },
        "submitted_at": { "$ref": "#/$defs/EpochMillis" },
        "delivered_at": { "$ref": "#/$defs/EpochMillis" }
      }
    },
    "ProxyTrafficPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reported_at", "instances"],
      "properties": {
        "reported_at": { "$ref": "#/$defs/EpochMillis" },
        "instances": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProxyTrafficEntry" }
        }
      }
    },
    "ProxyTrafficEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "bytes_up", "bytes_down", "connections"],
      "properties": {
        "instance_id": { "$ref": "#/$defs/Uuid" },
        "bytes_up": { "type": "integer", "minimum": 0 },
        "bytes_down": { "type": "integer", "minimum": 0 },
        "connections": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 }
      }
    },
    "DeviceStatePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "modems"],
      "properties": {
        "observed_at": { "$ref": "#/$defs/EpochMillis" },
        "modems": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/ModemState" }
        },
        "host": {
          "anyOf": [
            { "$ref": "#/$defs/HostState" },
            { "type": "null" }
          ]
        }
      }
    },
    "HostState": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "public_ip": { "$ref": "#/$defs/NullableString" },
        "cpu_percent": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 100 },
            { "type": "null" }
          ]
        },
        "memory_used_bytes": {
          "anyOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "memory_total_bytes": {
          "anyOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        }
      }
    },
    "ModemState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modem_imei", "state", "registration", "capability"],
      "properties": {
        "modem_imei": { "$ref": "#/$defs/Imei" },
        "state": { "type": "string", "enum": ["online", "offline", "recovering", "unknown"] },
        "registration": { "type": "string", "enum": ["registered", "searching", "denied", "unregistered", "unknown"] },
        "iccid": {
          "anyOf": [
            { "$ref": "#/$defs/Iccid" },
            { "type": "null" }
          ]
        },
        "signal_dbm": {
          "anyOf": [
            { "type": "integer", "minimum": -160, "maximum": 0 },
            { "type": "null" }
          ]
        },
        "rsrp": {
          "anyOf": [
            { "type": "integer", "minimum": -156, "maximum": -30 },
            { "type": "null" }
          ]
        },
        "rsrq": {
          "anyOf": [
            { "type": "integer", "minimum": -40, "maximum": 0 },
            { "type": "null" }
          ]
        },
        "sinr": {
          "anyOf": [
            { "type": "integer", "minimum": -20, "maximum": 40 },
            { "type": "null" }
          ]
        },
        "discovery": { "type": "string", "enum": ["qmi", "at"] },
        "manageable": { "type": "boolean" },
        "family": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 64 },
            { "type": "null" }
          ]
        },
        "imsi": {
          "anyOf": [
            { "$ref": "#/$defs/Imsi" },
            { "type": "null" }
          ]
        },
        "home_plmn": {
          "anyOf": [
            { "$ref": "#/$defs/Plmn" },
            { "type": "null" }
          ]
        },
        "serving_plmn": {
          "anyOf": [
            { "$ref": "#/$defs/Plmn" },
            { "type": "null" }
          ]
        },
        "capability": { "$ref": "#/$defs/CapabilitySummary" }
      }
    },
    "CapabilitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sms_mo", "sms_mt", "matrix_version"],
      "properties": {
        "sms_mo": { "type": "string", "enum": ["supported", "degraded", "unsupported", "unknown"] },
        "sms_mt": { "type": "string", "enum": ["supported", "degraded", "unsupported", "unknown"] },
        "matrix_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reason": { "$ref": "#/$defs/NullableString" }
      }
    },
    "CommandResultPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cmd_id", "status", "completed_at", "attempts"],
      "properties": {
        "cmd_id": { "$ref": "#/$defs/Uuid" },
        "status": { "type": "string", "enum": ["succeeded", "failed", "unknown", "expired", "cancelled"] },
        "completed_at": { "$ref": "#/$defs/EpochMillis" },
        "attempts": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "reason_code": { "$ref": "#/$defs/NullableString" },
        "reason": { "$ref": "#/$defs/NullableString" },
        "details": {
          "anyOf": [
            { "$ref": "#/$defs/ContextValue" },
            { "type": "null" }
          ]
        }
      }
    },
    "EsimInventoryPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modem_imei", "eid", "collected_at", "profiles"],
      "properties": {
        "modem_imei": { "$ref": "#/$defs/Imei" },
        "eid": { "type": "string", "pattern": "^[0-9]{32}$" },
        "collected_at": { "$ref": "#/$defs/EpochMillis" },
        "profiles": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/EsimProfile" }
        }
      }
    },
    "EsimProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iccid", "state"],
      "properties": {
        "iccid": { "$ref": "#/$defs/Iccid" },
        "state": { "type": "string", "enum": ["enabled", "disabled", "deleted", "unknown"] },
        "nickname": {
          "anyOf": [
            { "type": "string", "maxLength": 256 },
            { "type": "null" }
          ]
        }
      }
    },
    "AlertPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "code", "message", "occurred_at", "context"],
      "properties": {
        "level": { "type": "string", "enum": ["info", "warning", "error", "critical"] },
        "code": { "type": "string", "pattern": "^[a-z0-9_]{1,128}$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "occurred_at": { "$ref": "#/$defs/EpochMillis" },
        "context": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": { "$ref": "#/$defs/ContextValue" }
        }
      }
    },
    "Command": {
      "oneOf": [
        { "$ref": "#/$defs/SendSmsCommand" },
        { "$ref": "#/$defs/RestartModemCommand" },
        { "$ref": "#/$defs/SwitchEsimProfileCommand" },
      { "$ref": "#/$defs/ListEsimProfilesCommand" },
      { "$ref": "#/$defs/ReadEsimInfoCommand" },
      { "$ref": "#/$defs/RetrieveEsimNotificationCommand" },
      { "$ref": "#/$defs/RunAtCommandCommand" },
      { "$ref": "#/$defs/SendUssdCommand" },
      { "$ref": "#/$defs/SetRadioCommand" },
      { "$ref": "#/$defs/ScanOperatorsCommand" },
      { "$ref": "#/$defs/SelectOperatorCommand" },
      { "$ref": "#/$defs/ModemReportCommand" },
      { "$ref": "#/$defs/ResetModemUsbCommand" },
      { "$ref": "#/$defs/SetDataNetworkCommand" },
      { "$ref": "#/$defs/SetUsbnetModeCommand" },
      { "$ref": "#/$defs/ReregisterNetworkCommand" },
      { "$ref": "#/$defs/RefreshModemsCommand" },
      { "$ref": "#/$defs/ConfigureProxyCommand" },
      { "$ref": "#/$defs/ProxyLifecycleCommand" },
      { "$ref": "#/$defs/ProbeUpstreamProxyCommand" },
      { "$ref": "#/$defs/RotateIpCommand" },
        { "$ref": "#/$defs/UpdateCardPolicyCommand" },
        { "$ref": "#/$defs/UpdateCapabilityMatrixCommand" },
        { "$ref": "#/$defs/SelfUpdateCommand" }
      ]
    },
    "SendSmsCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "to", "body"],
      "properties": {
        "kind": { "const": "SendSms" },
        "to": { "type": "string", "pattern": "^\\+?[0-9]{1,15}$" },
        "body": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "modem_imei": { "$ref": "#/$defs/Imei" },
        "iccid": { "$ref": "#/$defs/Iccid" }
      },
      "anyOf": [
        { "required": ["modem_imei"] },
        { "required": ["iccid"] }
      ]
    },
    "RestartModemCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "modem_imei"],
      "properties": {
        "kind": { "const": "RestartModem" },
        "modem_imei": { "$ref": "#/$defs/Imei" }
      }
    },
    "RunAtCommandCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "modem_imei", "command"],
      "properties": {
        "kind": { "const": "RunAtCommand" },
        "modem_imei": { "$ref": "#/$defs/Imei" },
        "command": { "type": "string", "minLength": 2, "maxLength": 1024 },
        "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 300000 }
      }
    },
    "SendUssdCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "modem_imei", "code"],
      "properties": {
        "kind": { "const": "SendUssd" },
        "modem_imei": { "$ref": "#/$defs/Imei" },
        "code": { "type": "string", "minLength": 1, "maxLength": 182 },
        "stage": { "type": "string", "enum": ["start", "continue", "cancel"] }
      }
    },
    "SetRadioCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "modem_imei", "enabled"],
      "properties": {
        "kind": { "const": "SetRadio" },
        "modem_imei": { "$ref": "#/$defs/Imei" },
        "enabled": { "type": "boolean" }
      }
    },
    "ScanOperatorsCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "modem_imei"],
      "properties": {
        "kind": { "const": "ScanOperators" },
        "modem_imei": { "$ref": "#/$defs/Imei" }
      }
    },
    "SelectOperatorCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "modem_imei", "mode"],
      "properties": {
        "kind": { "const": "SelectOperator" },
        "modem_imei": { "$ref": "#/$defs/Imei" },
        "mode": { "type": "string", "enum": ["automatic", "manual"] },
        "plmn": { "$ref": "#/$defs/Plmn" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "manual" } }, "required": ["mode"] },
          "then": { "required": ["plmn"] }
        }
      ]
    },
    "ModemReportCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "modem_imei"],
      "properties": {
        "kind": { "const": "ModemReport" },
        "modem_imei": { "$ref": "#/$defs/Imei" }
      }
    },
    "ResetModemUsbCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "modem_imei"],
      "properties": {
        "kind": { "const": "ResetModemUsb" },
        "modem_imei": { "$ref": "#/$defs/Imei" }
      }
    },
    "SetDataNetworkCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "modem_imei", "enabled"],
      "properties": {
        "kind": { "const": "SetDataNetwork" },
        "modem_imei": { "$ref": "#/$defs/Imei" },
        "enabled": { "type": "boolean" }
      }
    },
    "SetUsbnetModeCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "modem_imei", "mode"],
      "properties": {
        "kind": { "const": "SetUsbnetMode" },
        "modem_imei": { "$ref": "#/$defs/Imei" },
        "mode": { "type": "string", "enum": ["rmnet", "ecm", "mbim", "rndis"] }
      }
    },
    "ReregisterNetworkCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "modem_imei"],
      "properties": {
        "kind": { "const": "ReregisterNetwork" },
        "modem_imei": { "$ref": "#/$defs/Imei" }
      }
    },
    "RefreshModemsCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "RefreshModems" }
      }
    },
    "ListEsimProfilesCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "modem_imei"],
      "properties": {
        "kind": { "const": "ListEsimProfiles" },
        "modem_imei": { "$ref": "#/$defs/Imei" }
      }
    },
    "ReadEsimInfoCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "modem_imei"],
      "properties": {
        "kind": { "const": "ReadEsimInfo" },
        "modem_imei": { "$ref": "#/$defs/Imei" }
      }
    },
    "RetrieveEsimNotificationCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "modem_imei", "sequence_number"],
      "properties": {
        "kind": { "const": "RetrieveEsimNotification" },
        "modem_imei": { "$ref": "#/$defs/Imei" },
        "sequence_number": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "ConfigureProxyCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "instances", "upstreams"],
      "properties": {
        "kind": { "const": "ConfigureProxy" },
        "instances": { "type": "array", "items": { "$ref": "#/$defs/ProxyInstanceSpec" } },
        "upstreams": { "type": "array", "items": { "$ref": "#/$defs/ProxyUpstreamSpec" } }
      }
    },
    "ProxyInstanceSpec": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "modem_imei", "protocol", "listen_addr", "listen_port", "enabled"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "name": { "type": "string", "maxLength": 128 },
        "modem_imei": { "$ref": "#/$defs/Imei" },
        "protocol": { "type": "string", "enum": ["socks5", "http"] },
        "listen_addr": { "type": "string", "maxLength": 64 },
        "listen_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "auth_enabled": { "type": "boolean" },
        "username": { "type": "string", "maxLength": 128 },
        "password": { "type": "string", "maxLength": 256 },
        "upstream_id": { "type": "string", "maxLength": 64 },
        "enabled": { "type": "boolean" }
      }
    },
    "ProxyUpstreamSpec": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "address", "protocol"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "name": { "type": "string", "maxLength": 128 },
        "address": { "type": "string", "maxLength": 256 },
        "protocol": { "type": "string", "enum": ["socks5", "http"] },
        "username": { "type": "string", "maxLength": 128 },
        "password": { "type": "string", "maxLength": 256 },
        "enabled": { "type": "boolean" }
      }
    },
    "ProxyLifecycleCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "instance_id", "action"],
      "properties": {
        "kind": { "const": "ProxyLifecycle" },
        "instance_id": { "$ref": "#/$defs/Uuid" },
        "action": { "type": "string", "enum": ["start", "stop", "restart"] }
      }
    },
    "ProbeUpstreamProxyCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "upstream_id"],
      "properties": {
        "kind": { "const": "ProbeUpstreamProxy" },
        "upstream_id": { "$ref": "#/$defs/Uuid" }
      }
    },
    "RotateIpCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "modem_imei"],
      "properties": {
        "kind": { "const": "RotateIp" },
        "modem_imei": { "$ref": "#/$defs/Imei" }
      }
    },
    "SwitchEsimProfileCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "modem_imei", "target_iccid"],
      "properties": {
        "kind": { "const": "SwitchEsimProfile" },
        "modem_imei": { "$ref": "#/$defs/Imei" },
        "target_iccid": { "$ref": "#/$defs/Iccid" }
      }
    },
    "UpdateCardPolicyCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "policy_version", "policies"],
      "properties": {
        "kind": { "const": "UpdateCardPolicy" },
        "policy_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "policies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/CardPolicy" }
        }
      }
    },
    "CardPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iccid", "cellular_enabled", "vertical"],
      "properties": {
        "iccid": { "$ref": "#/$defs/Iccid" },
        "cellular_enabled": { "type": "boolean" },
        "vertical": { "type": "string", "enum": ["cn", "intl"] },
        "apn": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 128 },
            { "type": "null" }
          ]
        }
      }
    },
    "UpdateCapabilityMatrixCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "matrix_version", "matrix_sha256", "matrix"],
      "properties": {
        "kind": { "const": "UpdateCapabilityMatrix" },
        "matrix_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "matrix_sha256": { "$ref": "#/$defs/Sha256" },
        "matrix": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 4096,
          "additionalProperties": { "$ref": "#/$defs/ContextValue" }
        }
      }
    },
    "SelfUpdateCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "url", "sha256", "signature"],
      "properties": {
        "kind": { "const": "SelfUpdate" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "url": { "$ref": "#/$defs/HttpsUrl" },
        "sha256": { "$ref": "#/$defs/Sha256" },
        "signature": { "type": "string", "minLength": 16, "maxLength": 1024, "contentEncoding": "base64" }
      }
    },
    "ProtocolErrorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "related_message_id", "retryable"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_envelope",
            "frame_too_large",
            "unsupported_version",
            "wrong_direction",
            "device_id_mismatch",
            "sequence_conflict",
            "sequence_state_invalid",
            "connection_superseded",
            "rate_limited"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "related_message_id": {
          "anyOf": [
            { "$ref": "#/$defs/Uuid" },
            { "type": "null" }
          ]
        },
        "retryable": { "type": "boolean" },
        "retry_after_ms": { "type": "integer", "minimum": 1, "maximum": 86400000 }
      }
    }
  }
}
